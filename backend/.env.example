# Copy to backend/.env for local development:   cp backend/.env.example backend/.env
# In production there is no .env file: set these in your host's dashboard instead.
# Never commit real values. backend/.env is ignored by git.

# --- Required ---------------------------------------------------------------------------
# MongoDB. Local:  mongodb://127.0.0.1:27017    Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=vexen

# Signs sign-in sessions and the links in emails. At least 32 characters.
# Generate fresh values with:   python backend/scripts/gen_secrets.py
JWT_SECRET=

# Strengthens the stored form of agent keys. Set it once, before the first agent key exists,
# and never change it: changing it stops every existing agent key from working.
API_KEY_PEPPER=

# --- AI: Anthropic only -----------------------------------------------------------------
# The ONLY AI credential in Vexen is an Anthropic API key (it starts with sk-ant-).
# A key from any other provider is refused at startup, and ANTHROPIC_BASE_URL is ignored:
# Vexen only ever talks to https://api.anthropic.com. Get a key at https://console.anthropic.com
# Leave empty to run without the AI features (the rule writer and the in-app helper).
ANTHROPIC_API_KEY=
# Only if your key is not tied to a single workspace (see docs/DEPLOY.md): the workspace's ID.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Anyone can sign up, so the server stops AI calls after this many in a rolling 24 hours
# (each typically costs a few cents). 0 turns the ceiling off. Also set a spending limit in
# the Anthropic Console: that is the hard stop.
AI_DAILY_CALL_LIMIT=500

# --- The site's own address -------------------------------------------------------------
# Used for links in emails, invitations and the developer page. On Render and Railway the
# address the host assigns is used automatically; set this when you add a custom domain.
# Leave it unset for local development. The Docker image refuses to start without an address
# (its own or the host's), so links in emails can never be built from a request.
# PUBLIC_APP_URL=https://vexen.example.com

# --- Optional: email alerts (approval requests, invitations) ----------------------------
# Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  and an App Password as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Vexen Security

# Where messages from the website's contact page are emailed (needs the SMTP settings above;
# one or more addresses separated by commas). They are saved in the database either way.
CONTACT_NOTIFY_EMAIL=

# --- Optional: phone notifications (browser push) ---------------------------------------
# python backend/scripts/gen_secrets.py prints a matching pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Optional: tuning -------------------------------------------------------------------
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# Where the built website is (default: ../frontend/build next to backend/). Only for unusual layouts.
# FRONTEND_BUILD_DIR=/srv/vexen/build

# Only if the website is hosted at a different address than the API (comma separated):
# CORS_ORIGINS=https://www.example.com
# Publish the pitch deck, cap table and one-pager from the website (they are not shipped
# in the Docker image; see .dockerignore):
# SERVE_INVESTOR_DOCS=true
